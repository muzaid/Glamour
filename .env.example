# Copy to apps/web/.env.local (and export for the worker). Never commit real values.
# Required in production (≥16 chars each). Dev/demo uses non-production fallbacks.
GLAMOTION_SESSION_SECRET=
PAYMENT_WEBHOOK_SECRET=
MEDIA_SIGNING_SECRET=
WORKER_TOKEN=

# Demo mode (fictional data, demo sign-in, sandbox pay page). Never enable on a real deployment.
GLAMOTION_DEMO_MODE=0
CHECKOUT_MODE=sandbox            # disabled | sandbox | live (live refused until tax/shipping/provider configured)

# Runtime AI: "deterministic" (offline demo) or "anthropic" (uses ANTHROPIC_API_KEY or an `ant auth login` profile)
AI_PROVIDER=deterministic
GLAMOTION_CLAUDE_MODEL=claude-opus-5-5

# Try-on model file (Apache-2.0 MediaPipe face landmarker). Self-host for production.
NEXT_PUBLIC_FACE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task

NEXT_PUBLIC_POSE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task

# Opt-in AI clothing try-on vendor (ADR-010). Unset = disabled.
# APPAREL_TRYON_PROVIDER=

# Worker
GLAMOTION_WEB_URL=http://localhost:3000
WORKER_ID=worker-1
# FFMPEG_PATH=/usr/bin/ffmpeg
# CHROMIUM_PATH=

# Supabase (ticket F-005 / F-011 — not yet wired)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=      # worker/server only
